@startuml c4-3-componentes-api
' Debe ir antes del include de C4 (la librería lo define con ?=).
!$LEGEND_TITLE_TEXT = "Leyenda"
!include <C4/C4_Component>
!include _estilo.puml
LAYOUT_TOP_DOWN()
title Nivel 3 · Componentes de la API (server/src)

Container(spa, "Aplicación web", "React")
ContainerDb(db, "Base de datos", "MariaDB")
Container(archivos, "Almacén de archivos", "Disco")
System_Ext(brevo, "Brevo")
System_Ext(turnstile, "Cloudflare Turnstile")
System_Ext(cron, "Cron de cPanel")

Boundary(api, "API — Express 4", "contenedor") {
  Component(server, "server.js", "Bootstrap", "Carga .env, db.init(), listen y timer de alertas cada 30 min.")
  Component(seguridad, "seguridad.js", "Middleware", "Cabeceras (CSP, HSTS…), caché y limitador por IP.", $tags="seguridad")
  Component(rutasPortal, "Router /api/portal", "app.js", "Rutas públicas: portal por token, recuperar enlace, baja de captación.")
  Component(rutasPanel, "Router /api", "app.js", "Rutas del panel tras requiereAuth: clientes, prospectos, correos, revisión, liquidaciones.")
  Component(auth, "auth.js", "Tokens HMAC", "Login con bloqueo, token de sesión 12 h, magic link del portal y token de baja.", $tags="seguridad")
  Component(turnstileMod, "turnstile.js", "Cliente HTTP", "Verifica el token del widget contra Cloudflare.", $tags="seguridad")
  Component(cifrado, "cifrado.js", "AES-256-GCM", "Cifra la clave DIAN y el estado del Liquidador con DATA_SECRET.", $tags="seguridad")
  Component(correo, "correo.js", "Servicio de correo", "Canal (Brevo > SMTP > Gmail), render de plantillas y envío en lotes; captación con tope diario.")
  Component(avisos, "avisos.js", "Servicio", "Decide cuándo avisar a la contadora: subidas y hitos de vencimiento, con dedupe.")
  Component(horario, "horarioContacto.js", "Reglas", "Horario de la Ley 2300 con festivos calculados (Pascua + Ley Emiliani).", $tags="nuevo")
  Component(entrega, "estadoEntrega.js", "Reglas + cliente HTTP", "Eventos de Brevo → entregado/diferido/rebote; excluye rebotes y quejas.", $tags="nuevo")
  Component(plantillaCap, "plantillaCaptacion.js", "Plantilla", "Correo de captación inicial (documento HTML) que siembra la config.", $tags="nuevo")
  Component(vencimientos, "vencimientos.js", "Reglas", "Cédula → fecha DIAN según los dos últimos dígitos.")
  Component(archivosMod, "archivos.js", "multer", "Guarda, valida y borra archivos en disco.")
  Component(datos, "datos.js", "Repositorio", "Todo el SQL y el mapeo fila → objeto de dominio.", $tags="datos")
  Component(dbMod, "db.js", "Pool + DDL", "Pool mysql2, CREATE TABLE idempotente y migraciones.")
  Component(seed, "seed.js", "Datos iniciales", "Calendario, plantillas de documentos y config (INSERT IGNORE).")
}

Rel(spa, seguridad, "JSON/HTTPS")
Rel(cron, rutasPanel, "GET /cron/alertas?clave=…", $tags="async")
Rel(seguridad, rutasPortal, "pasa")
Rel(seguridad, rutasPanel, "pasa")
Rel(rutasPanel, auth, "requiereAuth, login")
Rel(rutasPortal, auth, "valida magic link y token de baja")
Rel(rutasPortal, turnstileMod, "recuperar enlace")
Rel(rutasPanel, turnstileMod, "login")
Rel(rutasPanel, cifrado, "clave DIAN, Liquidador")
Rel(rutasPortal, cifrado, "guarda clave DIAN")
Rel(rutasPanel, correo, "envíos, previsualización")
Rel(rutasPortal, archivosMod, "subidas")
Rel(rutasPanel, archivosMod, "descargas y entregas")
Rel(rutasPanel, horario, "estado del envío de captación")
Rel(rutasPanel, datos, "lee y escribe")
Rel(rutasPortal, datos, "lee y escribe")
Rel(correo, datos, "config, envíos, prospectos")
Rel(correo, horario, "puedeContactar()")
Rel(correo, auth, "tokenPortal(), tokenBaja()")
Rel(correo, vencimientos, "fecha del cliente")
Rel(avisos, correo, "enviarCorreo()")
Rel(avisos, datos, "dedupe en envios")
Rel(avisos, vencimientos, "hitos 15/8/3/0")
Rel(server, dbMod, "init()")
Rel(server, avisos, "cada 30 min", $tags="async")
Rel(server, entrega, "cada 30 min", $tags="async")
Rel(rutasPanel, entrega, "revisar entregas")
Rel(entrega, datos, "marca rebote / baja")
Rel(entrega, brevo, "GET /smtp/statistics/events")
Rel(datos, dbMod, "q()")
Rel(dbMod, seed, "siembra")
Rel(seed, plantillaCap, "asunto/cuerpo de captación")
Rel(turnstileMod, turnstile, "HTTPS")
Rel(correo, brevo, "HTTPS")
Rel(dbMod, db, "mysql2")
Rel(archivosMod, archivos, "fs")

SHOW_LEGEND()
@enduml
