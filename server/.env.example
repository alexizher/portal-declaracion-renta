# Copia este archivo a .env y completa los valores.
# En el hosting (cPanel > Setup Node.js App) estos mismos valores se
# configuran como "Environment variables" de la aplicación.

# Contraseña para entrar al panel de administración
ADMIN_PASSWORD=cambia-esta-clave

# --- Base de datos MySQL/MariaDB ---
# En el hosting: crea la DB y el usuario en cPanel > MySQL Databases.
# cPanel les antepone el prefijo de tu cuenta, ej: repolite_renta / repolite_renta
# y el host es "localhost".
# En local: ./scripts/db-local.sh levanta una MariaDB en podman con estos valores:
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=renta
DB_USER=renta
DB_PASSWORD=renta_dev

# --- Correo ---
# Tres canales posibles, en orden de prioridad:
#
# 1) Brevo (API HTTPS, https://app.brevo.com > SMTP & API > API Keys).
#    Útil en hostings cuyo filtro saliente rechaza el SMTP local.
#    FROM_EMAIL debe estar verificado como remitente en Brevo.
#BREVO_API_KEY=xkeysib-...
#
# 2) SMTP genérico (p. ej. el servidor del propio hosting con un buzón cPanel).
#    Se usa si no hay BREVO_API_KEY.
#SMTP_HOST=localhost
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=notificaciones@tudominio.com
#SMTP_PASS=xxxxxxxx
#
# 3) Gmail directo (solo desarrollo local; los hostings bloquean SMTP externo).
#    GMAIL_APP_PASSWORD es una "contraseña de aplicación" (NO tu clave normal):
#    https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Remitente visible (por defecto SMTP_USER o GMAIL_USER) y dirección a la que
# llegan las respuestas de los clientes.
#FROM_EMAIL=notificaciones@tudominio.com
#REPLY_TO=tucorreo@gmail.com

# --- Portal de documentos (Fase 2) ---
# URL pública de la aplicación: con ella se arman los enlaces {{portal}} de
# los correos. Sin barra final.
#BASE_URL=https://declaraciones-renta-pn.repolite.link

# Carpeta donde se guardan los archivos que suben los clientes
# (por defecto server/uploads, fuera de public/).
#UPLOADS_DIR=/ruta/privada/uploads

# --- Avisos internos (Fase 3) ---
# Clave del endpoint GET /api/cron/alertas?clave=... que dispara la alerta
# diaria de vencimientos (configúralo en cPanel > Cron Jobs con un curl a las
# 7 am; también despierta la app si Passenger la durmió). Sin esta variable el
# endpoint queda deshabilitado; la app igual revisa cada 30 min mientras esté
# despierta. El correo destino se configura en el panel (pestaña Correos).
#CRON_SECRET=una-clave-larga-aleatoria

# --- Cloudflare Turnstile (anti-robots, opcional) ---
# Protege el login del panel y el formulario "recuperar mi enlace" del portal.
# Se crea en https://dash.cloudflare.com > Turnstile (widget tipo Managed).
# Sin estas variables los formularios funcionan sin verificación.
#TURNSTILE_SITE_KEY=0x...
#TURNSTILE_SECRET=0x...

# Puerto local de desarrollo (en el hosting lo asigna Passenger automáticamente)
PORT=3001
